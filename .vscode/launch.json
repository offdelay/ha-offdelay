{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Home Assistant: Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "homeassistant",
            "justMyCode": false,
            "args": [
                "--config",
                "${workspaceFolder}/config"
            ],
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}
